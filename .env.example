# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHECKUP_MODEL=gemini-3.6-flash
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
# 같은 Google 프로젝트의 앱 호출을 합산한다. 프로젝트 변경 시 이 값을 변경한다.
GEMINI_USAGE_SCOPE=smartcare-project
# 선택한 모델의 사진 기준 한도만 재정의하는 JSON. 생략한 한도는 기본값 사용.
GEMINI_MODEL_LIMITS={}

# MySQL database
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elder_care_DB
